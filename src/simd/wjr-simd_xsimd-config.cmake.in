if(NOT TARGET xsimd)
    find_package(xsimd 14.3.0 EXACT QUIET CONFIG HINTS "${_WJR_PACKAGE_PREFIX}")
endif()
if(NOT TARGET xsimd)
    set(wjr_simd_xsimd_FOUND FALSE)
    set(wjr_simd_xsimd_NOT_FOUND_MESSAGE "The simd_xsimd component requires xsimd 14.3.0.")
    return()
endif()
if(NOT TARGET wjr::simd_xsimd)
    include("${CMAKE_CURRENT_LIST_DIR}/wjrSimdXsimdTargets.cmake")
    target_link_libraries(wjr::simd_xsimd INTERFACE xsimd)
endif()
set(wjr_simd_xsimd_FOUND TRUE)
