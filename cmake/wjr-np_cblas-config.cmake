if(NOT TARGET wjr::np)
    include("${CMAKE_CURRENT_LIST_DIR}/wjr-np-config.cmake")
endif()
if(NOT TARGET wjr::np)
    set(wjr_np_cblas_FOUND FALSE)
    set(wjr_np_cblas_NOT_FOUND_MESSAGE "The np_cblas component requires np and its mdspan dependency.")
    return()
endif()
if(NOT TARGET wjr::np_cblas)
    include("${CMAKE_CURRENT_LIST_DIR}/wjrCblas.cmake")
    wjr_find_openblas(_WJR_CBLAS_TARGET)
    if(NOT _WJR_CBLAS_TARGET)
        set(wjr_np_cblas_FOUND FALSE)
        set(wjr_np_cblas_NOT_FOUND_MESSAGE "${WJR_CBLAS_REASON}")
        return()
    endif()
    include("${CMAKE_CURRENT_LIST_DIR}/wjrNpCblasTargets.cmake")
    target_link_libraries(wjr::np_cblas INTERFACE ${_WJR_CBLAS_TARGET})
    unset(_WJR_CBLAS_TARGET)
endif()
set(wjr_np_cblas_FOUND TRUE)
