if(NOT TARGET wjr::mimalloc)
    find_package(mimalloc 3.6 QUIET CONFIG)
    if(NOT mimalloc_FOUND OR NOT TARGET mimalloc)
        set(wjr_mimalloc_FOUND FALSE)
        set(wjr_mimalloc_NOT_FOUND_MESSAGE "The mimalloc component requires a prebuilt shared mimalloc 3.6 or later package.")
        return()
    endif()
    include("${CMAKE_CURRENT_LIST_DIR}/wjrMimallocTargets.cmake")
    target_link_libraries(wjr::mimalloc INTERFACE mimalloc)
endif()
set(wjr_mimalloc_FOUND TRUE)
