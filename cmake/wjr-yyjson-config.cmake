if(NOT TARGET wjr::yyjson)
    find_package(yyjson QUIET CONFIG)
    include("${CMAKE_CURRENT_LIST_DIR}/wjrYyjsonProvider.cmake")
    _wjr_check_yyjson_provider(_WJR_YYJSON_VALID)
    if(NOT yyjson_FOUND OR NOT _WJR_YYJSON_VALID)
        set(wjr_yyjson_FOUND FALSE)
        set(wjr_yyjson_NOT_FOUND_MESSAGE "The yyjson component requires prebuilt yyjson 0.13.0 with reader and UTF-8 validation.")
        unset(_WJR_YYJSON_VALID)
        return()
    endif()
    unset(_WJR_YYJSON_VALID)
    include("${CMAKE_CURRENT_LIST_DIR}/wjrYyjsonTargets.cmake")
    target_link_libraries(wjr::yyjson INTERFACE yyjson::yyjson)
endif()
set(wjr_yyjson_FOUND TRUE)
