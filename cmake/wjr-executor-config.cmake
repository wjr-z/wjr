if(NOT TARGET wjr::executor)
    find_package(Threads QUIET)
    if(NOT Threads_FOUND)
        set(wjr_executor_FOUND FALSE)
        set(wjr_executor_NOT_FOUND_MESSAGE "The executor component requires standard thread support.")
        return()
    endif()
    include("${CMAKE_CURRENT_LIST_DIR}/wjrExecutorTargets.cmake")
    target_link_libraries(wjr::executor INTERFACE Threads::Threads)
endif()
set(wjr_executor_FOUND TRUE)
