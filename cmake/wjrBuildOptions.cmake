include(AddFlags)

# Translate the old boolean only when the standard has not been selected explicitly.
set(_WJR_DEFAULT_CXX_STANDARD 20)
if(DEFINED WJR_DISABLE_CXX_20)
    message(DEPRECATION "WJR_DISABLE_CXX_20 is deprecated; use WJR_CXX_STANDARD=17 or 20.")
    if(WJR_DISABLE_CXX_20)
        set(_WJR_DEFAULT_CXX_STANDARD 17)
    endif()
endif()

set(WJR_CXX_STANDARD "${_WJR_DEFAULT_CXX_STANDARD}" CACHE STRING "Minimum C++ standard for WJR")
set_property(CACHE WJR_CXX_STANDARD PROPERTY STRINGS 17 20 23)
if(NOT WJR_CXX_STANDARD MATCHES "^(17|20|23)$")
    message(FATAL_ERROR "WJR_CXX_STANDARD must be 17, 20, or 23.")
endif()
set(WJR_CXX_FEATURE "cxx_std_${WJR_CXX_STANDARD}")
if(NOT WJR_CXX_FEATURE IN_LIST CMAKE_CXX_COMPILE_FEATURES)
    message(FATAL_ERROR "${CMAKE_CXX_COMPILER_ID} does not support ${WJR_CXX_FEATURE}.")
endif()
message(STATUS "WJR minimum C++ standard: ${WJR_CXX_STANDARD}")

set(_WJR_MSVC_FRONTEND OFF)
if(CMAKE_CXX_COMPILER_ID STREQUAL "MSVC" OR
   CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
    set(_WJR_MSVC_FRONTEND ON)
endif()

set(_WJR_DEFAULT_CPU_TARGET native)
if(_WJR_MSVC_FRONTEND OR CMAKE_CROSSCOMPILING)
    set(_WJR_DEFAULT_CPU_TARGET baseline)
endif()
set(WJR_CPU_TARGET "${_WJR_DEFAULT_CPU_TARGET}" CACHE STRING
    "Optimized module CPU target: native, baseline, or a compiler-specific architecture")
set_property(CACHE WJR_CPU_TARGET PROPERTY STRINGS native baseline)

set(WJR_CXX_FLAGS)
set(WJR_CXX_FLAGS_PRIVATE)
set(WJR_BASELINE_FLAGS)
set(WJR_ISA_FLAGS)
set(WJR_COMPILE_DEFINITIONS)
set(WJR_LINK_OPTIONS)

if(_WJR_MSVC_FRONTEND)
    list(APPEND WJR_CXX_FLAGS /Zc:preprocessor /Zc:lambda /EHsc /utf-8)
    list(APPEND WJR_CXX_FLAGS_PRIVATE /W3 /wd4146 /wd4309 /wd4244)
    if(WJR_CPU_TARGET STREQUAL "native")
        message(FATAL_ERROR "The MSVC frontend has no native target; use baseline or e.g. AVX2.")
    endif()
else()
    list(APPEND WJR_CXX_FLAGS_PRIVATE -Wall -Wextra -Wshadow -Wformat=2 -Wunused)
    AddFlagsIfExists(WJR_CXX_FLAGS_PRIVATE
        "-Waddress-of-packed-member -Wpointer-arith -Wcast-align -Wreorder -Wpacked -Wcast-qual")
endif()

if(NOT _WJR_MSVC_FRONTEND AND WJR_ARCH STREQUAL "x86")
    set(WJR_BASELINE_FLAGS -march=x86-64)
endif()

set(_WJR_CPU_FLAG)
if(WJR_CPU_TARGET STREQUAL "baseline")
    if(NOT _WJR_MSVC_FRONTEND AND WJR_ARCH STREQUAL "x86")
        set(_WJR_CPU_FLAG "-march=x86-64")
    endif()
else()
    if(CMAKE_CROSSCOMPILING AND WJR_CPU_TARGET STREQUAL "native")
        message(FATAL_ERROR "Cross-compiling requires baseline or an explicit WJR_CPU_TARGET.")
    endif()
    if(_WJR_MSVC_FRONTEND)
        set(_WJR_CPU_FLAG "/arch:${WJR_CPU_TARGET}")
    else()
        set(_WJR_CPU_FLAG "-march=${WJR_CPU_TARGET}")
    endif()
endif()
if(_WJR_CPU_FLAG)
    string(SHA256 _WJR_CPU_KEY "${CMAKE_CXX_COMPILER_ID};${CMAKE_CXX_COMPILER_VERSION};${CMAKE_CXX_COMPILER_TARGET};${_WJR_CPU_FLAG}")
    check_cxx_compiler_flag("${_WJR_CPU_FLAG}" "WJR_CPU_FLAG_${_WJR_CPU_KEY}")
    if(NOT WJR_CPU_FLAG_${_WJR_CPU_KEY})
        message(FATAL_ERROR "Unsupported WJR_CPU_TARGET: ${WJR_CPU_TARGET}")
    endif()
    list(APPEND WJR_ISA_FLAGS "${_WJR_CPU_FLAG}")
endif()
message(STATUS "WJR CPU target: ${WJR_CPU_TARGET}")

if(WJR_DISABLE_EXCEPTIONS)
    list(APPEND WJR_COMPILE_DEFINITIONS WJR_DISABLE_EXCEPTIONS)
    if(_WJR_MSVC_FRONTEND)
        list(APPEND WJR_COMPILE_DEFINITIONS _HAS_EXCEPTIONS=0)
    else()
        list(APPEND WJR_CXX_FLAGS -fno-exceptions)
    endif()
endif()
if(WJR_LIGHT_ASSERT)
    list(APPEND WJR_COMPILE_DEFINITIONS WJR_LIGHT_ASSERT)
endif()

if(WJR_ENABLE_COVERAGE)
    if(NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang" OR _WJR_MSVC_FRONTEND)
        message(FATAL_ERROR "WJR_ENABLE_COVERAGE requires a Clang GNU-compatible frontend.")
    endif()
    list(APPEND WJR_CXX_FLAGS_PRIVATE -fprofile-instr-generate -fcoverage-mapping -fno-inline)
    list(APPEND WJR_LINK_OPTIONS -fprofile-instr-generate -fcoverage-mapping)
endif()

if(WJR_ENABLE_ASAN)
    if(_WJR_MSVC_FRONTEND)
        message(FATAL_ERROR "WJR_ENABLE_ASAN currently requires a GNU-compatible frontend.")
    endif()
    list(APPEND WJR_CXX_FLAGS -fsanitize=address -fno-omit-frame-pointer)
    list(APPEND WJR_LINK_OPTIONS -fsanitize=address)
    if(WIN32)
        # Configure the CRT before creating dependencies as well as WJR targets.
        set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
    endif()
endif()

if(WJR_PUBLIC_FLAGS)
    list(APPEND WJR_CXX_FLAGS ${WJR_CXX_FLAGS_PRIVATE})
endif()
