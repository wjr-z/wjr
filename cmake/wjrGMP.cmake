include_guard(GLOBAL)

function(wjr_link_gmp target)
    # The legacy opt-in only supplies a default for the shared option.
    if(WJR_USE_GMP AND NOT DEFINED WJR_USE_GMP_TESTS)
        option(WJR_USE_GMP_TESTS "Use GMP library for tests and benchmarks" ON)
    endif()
    if(DEFINED WJR_USE_GMP_TESTS AND NOT WJR_USE_GMP_TESTS)
        option(WJR_USE_GMP_TESTS "Use GMP library for tests and benchmarks" OFF)
        return()
    endif()

    if(NOT TARGET wjr-test-gmp)
        set(_wjr_gmp_pkgconfig FALSE)
        find_package(GMP QUIET)
        if(NOT GMP_FOUND)
            find_package(PkgConfig QUIET)
            if(PkgConfig_FOUND)
                pkg_check_modules(GMP QUIET IMPORTED_TARGET GLOBAL gmp)
                set(_wjr_gmp_pkgconfig "${GMP_FOUND}")
            endif()
        endif()
        option(WJR_USE_GMP_TESTS "Use GMP library for tests and benchmarks" "${GMP_FOUND}")
        if(NOT WJR_USE_GMP_TESTS)
            return()
        endif()
        if(NOT GMP_FOUND)
            message(FATAL_ERROR
                "WJR_USE_GMP_TESTS=ON requires an available GMP package or pkg-config provider.")
        endif()

        add_library(wjr-test-gmp INTERFACE)
        target_compile_definitions(wjr-test-gmp INTERFACE WJR_USE_GMP)
        if(_wjr_gmp_pkgconfig)
            target_link_libraries(wjr-test-gmp INTERFACE PkgConfig::GMP)
        else()
            target_include_directories(wjr-test-gmp INTERFACE ${GMP_INCLUDE_DIRS})
            target_link_libraries(wjr-test-gmp INTERFACE ${GMP_LIBRARIES})
        endif()
    endif()

    target_link_libraries(${target} PRIVATE wjr-test-gmp)
endfunction()
